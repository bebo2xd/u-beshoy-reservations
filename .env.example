# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=https://u-beshoy-reservations.vercel.app

# OneSignal (Android push via Capacitor)
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Email via SMTP (optional — can also be set in Admin → Settings)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=

# WhatsApp via Evolution API (optional)
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
ADMIN_WHATSAPP=2010xxxxxxxx

# Vercel Cron (optional but recommended in production)
CRON_SECRET=
